# Copy to .env and enter keys locally. Never commit .env or paste keys into chat.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Explicit opt-in for outbound model calls after adding keys.
TERRA_LLM_ENABLED=false
# Accounting only. No spending cutoff. Does not change the provider account tier.
TERRA_GEMINI_BILLING_MODE=FREE_TIER
# Conservative planning conversion, not a live exchange-rate quote.
TERRA_LLM_USD_TO_MYR=5
# Minimum seconds between Gemini generation calls per model. Account quotas may differ.
TERRA_GEMINI_MIN_INTERVAL_SECONDS=15
